{
	"ci": {
		"collect": {
			"url": [
				"http://localhost:4321/",
				"http://localhost:4321/posts/council-votes-to-rebuild-the-seawall",
				"http://localhost:4321/category/city",
				"http://localhost:4321/authors/mara-okafor",
				"http://localhost:4321/pages/about",
				"http://localhost:4321/search?q=harbor"
			],
			"numberOfRuns": 3
		},
		"assert": {
			"assertMatrix": [
				{
					"matchingUrlPattern": "^(?!.*/search).*$",
					"assertions": {
						"categories:performance": [
							"error",
							{
								"minScore": 0.95
							}
						],
						"categories:accessibility": [
							"error",
							{
								"minScore": 0.95
							}
						],
						"categories:best-practices": [
							"error",
							{
								"minScore": 0.95
							}
						],
						"categories:seo": [
							"error",
							{
								"minScore": 0.95
							}
						]
					}
				},
				{
					"matchingUrlPattern": "/search",
					"assertions": {
						"categories:performance": [
							"error",
							{
								"minScore": 0.95
							}
						],
						"categories:accessibility": [
							"error",
							{
								"minScore": 0.95
							}
						],
						"categories:best-practices": [
							"error",
							{
								"minScore": 0.95
							}
						]
					}
				}
			]
		},
		"upload": {
			"target": "filesystem",
			"outputDir": ".lighthouseci"
		}
	}
}
