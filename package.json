{
	"name": "astro-theme-masthead",
	"version": "1.0.9",
	"private": true,
	"type": "module",
	"emdash": {
		"label": "Blog",
		"seed": "seed/seed.json"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"deploy": "astro build && wrangler deploy",
		"typecheck": "astro check",
		"reset": "rm -rf .wrangler/state .emdash/migrations.json && astro dev",
		"lint": "eslint .",
		"format": "prettier --write .",
		"check:contrast": "node scripts/check-contrast.mjs"
	},
	"dependencies": {
		"@astrojs/cloudflare": "14.3.2",
		"@astrojs/react": "6.0.6",
		"@emdash-cms/cloudflare": "0.38.0",
		"astro": "7.3.3",
		"emdash": "0.38.0",
		"react": "19.2.4",
		"react-dom": "19.2.4"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@cloudflare/workers-types": "5.20260916.1",
		"eslint": "10.10.0",
		"eslint-plugin-astro": "3.2.0",
		"prettier": "3.9.7",
		"prettier-plugin-astro": "1.0.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.70.0",
		"wrangler": "4.133.0"
	},
	"packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
	"engines": {
		"node": ">=22.12.0"
	}
}
