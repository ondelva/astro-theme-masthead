---
import { getTerm, getEmDashCollection, decodeSlug } from "emdash";
import Base from "../../layouts/Base.astro";
import Archive from "../../components/Archive.astro";
import { PAGE_CACHE } from "../../utils/cache";

const PAGE_SIZE = 15;

const slug = decodeSlug(Astro.params.slug);
const term = slug ? await getTerm("category", slug, { includeCounts: false }) : null;

if (!term) {
	return Astro.rewrite("/404");
}

const cursor = Astro.url.searchParams.get("cursor") ?? undefined;
const { entries, nextCursor, cacheHint } = await getEmDashCollection("posts", {
	where: { category: term.slug },
	orderBy: { published_at: "desc" },
	// The lead story takes two cells on the first page; one fewer keeps the rows full.
	limit: cursor ? PAGE_SIZE : PAGE_SIZE - 1,
	cursor,
});

if (Astro.cache?.enabled) Astro.cache.set({ ...cacheHint, ...PAGE_CACHE });
---

<Base title={term.label} description={`${term.label} coverage, newest first.`}>
	<Archive
		title={term.label}
		posts={entries}
		nextCursor={nextCursor}
		lead={!cursor}
		sectionKicker={false}
		empty={`No ${term.label} stories yet.`}
	/>
</Base>
