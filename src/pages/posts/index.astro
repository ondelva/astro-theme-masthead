---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import Archive from "../../components/Archive.astro";
import { PAGE_CACHE } from "../../utils/cache";
import { ui } from "../../utils/ui";

const PAGE_SIZE = 15;

const cursor = Astro.url.searchParams.get("cursor") ?? undefined;
const { entries, nextCursor, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: PAGE_SIZE,
	cursor,
});

if (Astro.cache?.enabled) Astro.cache.set({ ...cacheHint, ...PAGE_CACHE });
---

<Base title={ui.posts.title} description={ui.posts.description}>
	<Archive title={ui.posts.title} posts={entries} nextCursor={nextCursor} empty={ui.posts.empty} />
</Base>
